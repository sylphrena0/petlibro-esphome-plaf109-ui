{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "ES2025.Intl", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "erasableSyntaxOnly": true,
    "rootDir": "src",
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
